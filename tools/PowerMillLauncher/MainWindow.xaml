<Window x:Class="PowerMillLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerMill &amp; CAD Auto-Builder" Height="480" Width="680"
        Background="#0B132B" Foreground="#E0E1DD" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Permission Badge -->
        <Border Grid.Row="0" Background="#1C2541" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PowerMill &amp; CAD One-Click Runner" FontWeight="Bold" FontSize="18" Foreground="#48CAE4"/>
                    <TextBlock Text="Builds C# assemblies, registers COM interop, and launches local CAD models." FontSize="11" Foreground="#90E0EF" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Elevation Status -->
                <Border Grid.Column="1" Background="#0B132B" CornerRadius="8" Padding="10,6" BorderBrush="#0077B6" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ " FontSize="12"/>
                        <TextBlock x:Name="TxtPermissionStatus" Text="Administrator: GRANTED" FontWeight="SemiBold" FontSize="11" Foreground="#06D6A0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Detected Local Files Section -->
        <Border Grid.Row="1" Background="#1C2541" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="AUTO-DETECTED LOCAL ENVIRONMENT" FontWeight="SemiBold" FontSize="11" Foreground="#90E0EF" Margin="0,0,0,8"/>
                <Grid Margin="0,2">
                    <TextBlock Text="Autodesk Install:" FontSize="11" Foreground="#A9D6E5"/>
                    <TextBlock x:Name="TxtPowerMillPath" Text="C:\Program Files\Autodesk\PowerMill 2024\sys\exec64\pmill.exe" FontSize="11" Foreground="#F0F3F4" HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,4">
                    <TextBlock Text="Local CAD Part:" FontSize="11" Foreground="#A9D6E5"/>
                    <ComboBox x:Name="CmbCadFiles" SelectedIndex="0" HorizontalAlignment="Right" Width="360" Background="#0B132B" Foreground="Black">
                        <ComboBoxItem Content="Manifold_Block_5Axis.pmlprj (PowerMill Project)"/>
                        <ComboBoxItem Content="Turbine_Flange_Mount.dwg (AutoCAD Drawing)"/>
                        <ComboBoxItem Content="Die_Core_Cavity_P20.step (STEP Solid)"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Real-Time Build Output Log -->
        <Border Grid.Row="2" Background="#03071E" CornerRadius="10" Padding="10" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#64DFDF" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Big One-Click Action Button -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBuildAndLaunch" Content="⚡ ONE-CLICK BUILD &amp; OPEN CAD" Grid.Column="0" Background="#00B4D8" Foreground="#03071E" FontWeight="Bold" FontSize="14" Height="44" Cursor="Hand" Click="BtnBuildAndLaunch_Click" Margin="0,0,10,0"/>

            <Button x:Name="BtnElevate" Content="🛡️ Re-Run as Admin" Grid.Column="1" Background="#3A0CA3" Foreground="White" FontWeight="SemiBold" FontSize="11" Height="44" Padding="14,0" Cursor="Hand" Click="BtnElevate_Click"/>
        </Grid>
    </Grid>
</Window>
